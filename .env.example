# GEMINI_API_KEY: Required for server-side Gemini AI calls (label vision & daily check-in analysis).
# AI Studio automatically injects this at runtime from Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Twilio SMS notifications for high/urgent alerts (silently skipped if unset)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
CAREGIVER_PHONE=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
